# Docker Environment Variables for Local Development
# Copy this file to .env and update with your actual values

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# ImageKit Configuration
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=your_imagekit_url_endpoint

# Stripe Configuration
STRIPE_API_KEY=your_stripe_api_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Svix Configuration (for webhooks)
SVIX_WEBHOOK_SECRET=your_svix_webhook_secret

# Database (MongoDB will run in docker-compose)
MONGODB_URI=mongodb://admin:password123@mongodb:27017/chatgpt?authSource=admin

# JWT Secret
JWT_SECRET=your_jwt_secret_key_change_this_to_something_secure

# Node Environment
NODE_ENV=production
